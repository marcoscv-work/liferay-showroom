								{
									"id": "text-2",
									"value": {
										"text": {
											"value_i18n": {
												"en_US": "Fragment sets, page templates and style books, rendered without a Liferay: documented, versioned and readable by agents. Everything you see is exactly what gets imported."
											}
										}
									}
								},
								{
									"id": "title-1",
									"value": {
										"text": {
											"value_i18n": {
												"en_US": "Your Liferay design system, published"
											}
										}
									}
								}
							],
							"indexed": true
						}
