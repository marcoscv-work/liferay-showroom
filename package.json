{
  "name": "liferay-storybook",
  "private": true,
  "version": "1.2.0",
  "homepage": "https://marcoscv-work.github.io/liferay-storybook/",
  "type": "module",
  "scripts": {
    "pack": "node scripts/pack-collections.mjs",
    "dev": "npm run pack && vite",
    "build": "npm run pack && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "release": "vite-node scripts/release.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "jszip": "^3.10.1",
    "marked": "^18.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
